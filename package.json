{
  "name": "career-strike",
  "version": "0.4.0",
  "description": "Local-first, privacy-first job-hunting platform with an independent dashboard and MCP integrations.",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "bin": {
    "career-strike": "dist/cli/index.js"
  },
  "files": [
    "dist",
    "plugins",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "docs"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json && vite build && node --import tsx scripts/stamp-release.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.web.json && tsc -p tsconfig.e2e.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "dev": "node --import tsx scripts/dev.ts",
    "dev:serve": "node --import tsx src/cli/index.ts serve",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm test",
    "acceptance": "node --import tsx scripts/acceptance.ts",
    "prepare": "lefthook install || true",
    "privacy-scan": "node --import tsx scripts/privacy-scan.ts",
    "test:e2e": "npm run build && playwright test",
    "test:live": "CS_LIVE=1 vitest run test/live",
    "test:update": "node --import tsx scripts/update-rehearsal.ts",
    "release": "node --import tsx scripts/release.ts",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.2",
    "better-sqlite3": "13.0.3",
    "commander": "15.0.0",
    "entities": "9.0.0",
    "fastify": "5.12.7",
    "fflate": "0.8.3",
    "htmlparser2": "12.0.0",
    "jsonc-parser": "3.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@biomejs/biome": "^2.6.5",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource/atkinson-hyperlegible": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@hookform/resolvers": "^7.0.2",
    "@playwright/test": "1.64.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "@tailwindcss/vite": "^4.3.4",
    "@tanstack/react-query": "5.105.1",
    "@tanstack/react-router": "1.170.46",
    "@types/better-sqlite3": "9.6.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lefthook": "^2.2.2",
    "lucide-react": "^1.68.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.4",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
